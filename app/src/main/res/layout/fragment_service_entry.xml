<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    tools:context=".ServiceEntryFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Fejléc -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/AutoNev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nincs kiválasztott autó"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/UjBejegyzes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Új bejegyzés"
                    android:textColor="#000000"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoValtas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#3A3A3A"
                android:text="Vissza"
                android:textColor="#FFFFFF"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <View
            android:id="@+id/Fejlec"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#333333" />

        <!-- Szerviz neve -->
        <TextView
            android:id="@+id/SzervizNev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Szerviz neve"
            android:textColor="#000000"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/Szerviz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#2A2A2A"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <EditText
                android:id="@+id/SzervizFajta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="pl. Olajcsere &amp; Szűrők"
                android:inputType="textCapSentences"
                android:padding="16dp"
                android:textColor="#F8F8F8"
                android:textColorHint="#777777" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/Kmszoveg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Km állás"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/Kmdoboz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#2A2A2A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <EditText
                        android:id="@+id/KmAllas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="142500"
                        android:inputType="number"
                        android:padding="16dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#777777" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/KoltsegSzoveg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Költség (Ft)"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/KoltsegDoboz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#2A2A2A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <EditText
                        android:id="@+id/KoltsegOsszeg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="45000"
                        android:inputType="number"
                        android:padding="16dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#777777" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Csatolt számla / fotó -->
        <TextView
            android:id="@+id/SzamlaFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Csatolt Számla / Fotó"
            android:textColor="#000000"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/SzamlaDoboz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#222222"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#555555"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/FotoKep"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Fotó csatolása"
                    android:src="@android:drawable/ic_menu_camera" />

                <TextView
                    android:id="@+id/FotoSzoveg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Fotó vagy számla csatolása"
                    android:textColor="#FBFBFB" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Csatolt fájl (csak akkor látszik, ha van csatolmány) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/llAttached"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#222222"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#555555"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Csatolt fájl"
                    android:src="@android:drawable/ic_menu_agenda" />

                <TextView
                    android:id="@+id/tvAttachedName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="szamla.pdf"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mentés -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/BtnMentes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2A2A2A"
            android:text="Bejegyzés mentése"
            android:textColor="#FFFFFF"
            app:cornerRadius="28dp"
            app:strokeColor="#555555"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>